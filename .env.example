# Copy this file to ".env" (remove the ".example" part) and fill in your real key.
# The .env file itself should NEVER be committed to git or shared — it's your secret.

GOOGLE_API_KEY=your_actual_key_here

# Optional — only set this if you want the data/ folder somewhere other than
# the default location (project_root/data)
# JIO_DATA_ROOT=/path/to/your/data/folder

# Optional — require an X-API-Key header on POST /ask. Unset = auth disabled.
# API_KEY=

# Optional — per-IP rate limit on POST /ask (defaults: 20 requests / 60s)
# RATE_LIMIT_MAX_REQUESTS=20
# RATE_LIMIT_WINDOW_SECONDS=60

# Optional — where ADK session history is persisted (SQLAlchemy URL).
# Defaults to sqlite:///<JIO_DATA_ROOT>/sessions.db
# SESSIONS_DB_URL=
